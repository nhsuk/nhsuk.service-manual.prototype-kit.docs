{
  "name": "nhsuk-prototype-kit",
  "description": "Website and documentation for the NHS prototype kit.",
  "homepage": "https://prototype-kit.service-manual.nhs.uk",
  "private": true,
  "scripts": {
    "build": "eleventy",
    "lint:prettier": "prettier . --check",
    "lint:prettier:fix": "prettier . --write",
    "lint:js": "eslint '**/*.js'",
    "lint:js:fix": "eslint '**/*.js' --fix",
    "lint": "npm run lint:prettier && npm run lint:js",
    "lint:fix": "npm run lint:prettier:fix && npm run lint:js:fix",
    "prestart": "npm run build",
    "start": "eleventy --serve --quiet"
  },
  "author": {
    "name": "NHS England",
    "url": "https://www.england.nhs.uk"
  },
  "repository": "github:nhsuk/nhsuk.service-manual.prototype-kit.docs",
  "bugs": {
    "url": "https://github.com/nhsuk/nhsuk.service-manual.prototype-kit.docs/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@x-govuk/nhsuk-eleventy-plugin": "^1.4.4"
  },
  "devDependencies": {
    "@x-govuk/eslint-config": "^0.0.3",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": "^24.11.0",
    "npm": "^11.6.1 <11.6.3 || ^11.6.4"
  },
  "type": "module"
}
